# ==========================================================================
# Digital Heroes — Environment Configuration
# Copy this file to .env in apps/api and apps/web (see each app's README).
# NEVER commit a real .env file. NEVER commit real secrets.
# ==========================================================================

# ---- Supabase ----
# Create a new Supabase project for this product (do not reuse a personal one).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
# Leave these blank in local development to automatically use the built-in
# clearly-labeled DEV MOCK Stripe adapter (see apps/api/src/modules/subscriptions/stripe.provider.ts).
# Populate with TEST MODE keys (sk_test_..., pk_test_...) to exercise real Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- App ----
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# ---- Security ----
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
